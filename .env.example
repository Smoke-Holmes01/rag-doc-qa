# 默认仅做离线流程验证；live 不会自动回退 mock
MODEL_MODE=mock
# 相对项目根目录解析
DOCS_DIR=data/docs
INDEX_DIR=storage/indexes
# live 填 siliconflow；mock 模式不调用这些接口
CHAT_ADAPTER=
EMBEDDING_ADAPTER=
# 包含 /v1，不能包含密钥、用户名或查询参数；地址分别配置
CHAT_BASE_URL=
EMBEDDING_BASE_URL=
# 密钥只放本地 .env 或运行环境，绝不提交
CHAT_API_KEY=
EMBEDDING_API_KEY=
# 真实模型名无默认值，参见 README 的硅基流动配置示例
CHAT_MODEL=
EMBEDDING_MODEL=
# 连接超时为 min(5, 此值) 秒；读取/写入/连接池等待为此值
HTTP_TIMEOUT_SECONDS=30
# 离线嵌入的小批量大小
EMBEDDING_BATCH_SIZE=16
# 字符上限；仅超长段落切片使用重叠
CHUNK_MAX_CHARS=800
CHUNK_OVERLAP_CHARS=100
# 默认和最大检索数量
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_K=8
# 含来源封装的字符预算，并非 token 预算
CONTEXT_MAX_CHARS=4000
# 余弦分数门槛，不能作为可靠性保证
MIN_SIMILARITY=0.0
# 问题字符数上限
QUESTION_MAX_CHARS=1000
# 映射到硅基流动 max_tokens
CHAT_MAX_OUTPUT_TOKENS=1024
